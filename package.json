{
  "name": "urbanclap",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:customer": "npm run dev --workspace=@urbanclap/customer",
    "dev:provider": "npm run dev --workspace=@urbanclap/provider",
    "dev:admin": "npm run dev --workspace=@urbanclap/admin",
    "build:customer": "npm run build --workspace=@urbanclap/customer",
    "build:provider": "npm run build --workspace=@urbanclap/provider",
    "build:admin": "npm run build --workspace=@urbanclap/admin",
    "build": "npm run build --workspaces --if-present",
    "lint:rules": "tsx scripts/check-rules.ts",
    "test:posting": "tsx scripts/test-posting-flow.ts",
    "test:race": "tsx scripts/test-race-condition.ts",
    "check": "oxlint && tsx scripts/check-rules.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "lucide-react": "^1.49.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
